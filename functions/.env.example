# Asset Doctor — Cloud Functions env (local / emulator)
# Copy secrets into Firebase Secret Manager for production.
# Never commit real API tokens.

# Email delivery (onMailQueueCreate) — set via secrets in prod:
#   firebase functions:secrets:set RESEND_API_KEY
#   # or SENDGRID_API_KEY

# Vision OCR (scanInvoiceVision):
#   firebase functions:secrets:set VISION_API_KEY

# Admin HTTP: grantAdminAccess
ADMIN_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# WhatsApp worker (onWhatsAppQueueCreate / whatsappWebhook / whatsappOpsHealth / adminTestWelcome):
#   firebase functions:secrets:set META_WHATSAPP_ACCESS_TOKEN
#   firebase functions:secrets:set META_WHATSAPP_PHONE_NUMBER_ID
#   firebase functions:secrets:set META_WEBHOOK_VERIFY_TOKEN
# Optional approved test recipient for Admin "Test Welcome Flow" (digits, no token):
#   WHATSAPP_TEST_TO=9198XXXXXXXX
