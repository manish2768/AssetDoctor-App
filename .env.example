# ==============================================================================
# ASSET DOCTOR (GADI DOCTOR) — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env or .env.local and populate the values securely.
# NEVER commit your actual .env file or real secrets to Git.

# ------------------------------------------------------------------------------
# 1. META WHATSAPP BUSINESS CLOUD API (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# System User Access Token generated from Meta Business Manager with permissions:
# - whatsapp_business_management
# - whatsapp_business_messaging
META_WHATSAPP_ACCESS_TOKEN=your_meta_system_user_permanent_access_token

# WhatsApp Phone Number ID (from WhatsApp Manager -> API Setup / Phone Numbers)
META_WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# Meta WhatsApp Business Account ID (WABA ID)
META_WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id

# Meta Graph API Version (defaults to v21.0)
META_WHATSAPP_API_VERSION=v21.0

# Optional webhook verify token (Cloud Function whatsappWebhook + local server.ts)
META_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# Optional local Express guard for POST /api/whatsapp/welcome — never ship this to the APK
WHATSAPP_INTERNAL_SECRET=your_long_random_internal_secret

# DO NOT set EXPO_PUBLIC_ALLOW_CLIENT_WHATSAPP=1 in production builds.
# Welcome send must go: signup → notification_queue → Cloud Function → Meta.

# ------------------------------------------------------------------------------
# 2. FIREBASE CLIENT & CLOUD CONFIGURATION
# ------------------------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=assetdoctor-5fd25.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=assetdoctor-5fd25
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=assetdoctor-5fd25-vault
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# ------------------------------------------------------------------------------
# 3. GOOGLE / OCR / AI SERVICES
# ------------------------------------------------------------------------------
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=926559836985-1jschm7e172vqo2rav99oif3uoq93ftq.apps.googleusercontent.com
EXPO_PUBLIC_OCR_VISION_URL=https://asia-south1-assetdoctor-5fd25.cloudfunctions.net/scanInvoiceVision
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key
